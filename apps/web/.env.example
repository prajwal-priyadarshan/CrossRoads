# Web app (Vite) configuration. Copy to .env.
# Only variables prefixed with VITE_ reach the browser bundle; never put secrets here.
# Runtime settings (email domains, demo accounts, feature flags) come from the API: GET /api/config.

# Dev server port
VITE_DEV_PORT=5173
# Where the dev server forwards /api (production uses the Vercel rewrite instead)
API_PROXY_TARGET=http://localhost:4000
