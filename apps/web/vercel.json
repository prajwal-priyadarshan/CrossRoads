{
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build -w apps/web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://amrita-ascend-1.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
