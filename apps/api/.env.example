# ─────────────────────────────────────────────────────────────
# BridgeUp API configuration. Copy to .env and fill in values.
# Every value is validated at startup in src/config/env.ts.
# Leave optional keys empty to disable the feature.
# ─────────────────────────────────────────────────────────────

# ── App ──
NODE_ENV=development
PORT=4000
APP_NAME=BridgeUp
# Web origin allowed by CORS (local dev only; production uses the same-origin /api rewrite)
WEB_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace (defaults: info in production, debug otherwise)
LOG_LEVEL=

# ── Database (Neon) ──
# Pooled URL for the running app, direct (non-pooled) URL for Prisma CLI migrations.
# Use sslmode=verify-full and do NOT include channel_binding (Prisma cannot connect with it).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# ── Auth ──
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_DAYS=7
# Comma-separated; subdomains are allowed too (amrita.edu also accepts am.students.amrita.edu)
ALLOWED_EMAIL_DOMAINS=amrita.edu
# Demo login (pitch/demo only; set false for any real launch)
DEMO_MODE=true
DEMO_LOGIN_HANDLES=ananya,rahul,meera,admin
DEMO_EMAIL_SUFFIX=@demo.bridgeup

# ── Email ──
# console prints verification codes to the API log; resend sends real emails
EMAIL_MODE=console
RESEND_API_KEY=
EMAIL_FROM=BridgeUp <no-reply@example.com>

# ── AI (Phase 09) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high
AI_EFFORT=medium
AI_MAX_TOKENS=16000
AI_TIMEOUT_MS=60000

# ── Payments (Phase 11, Razorpay test mode) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Academic calendar ──
# Month (1-12) the odd semester starts; used to work out a student's current semester
ACADEMIC_YEAR_START_MONTH=7

# ── Rate limits (requests per window) ──
RATE_LIMIT_AUTH_PER_15M=20
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_AI_PER_HOUR=20

# ── API docs ──
# Swagger UI at /api/docs. Defaults to on outside production.
API_DOCS_ENABLED=

# ── Seeds (local only) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
