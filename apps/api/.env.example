NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Neon: pooled URL for the running app, direct (non-pooled) URL for Prisma CLI migrations.
# Drop channel_binding from the URLs; Prisma's engine cannot connect with it.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"
SEED_ADMIN_EMAIL="admin@demo.bridgeup"
SEED_ADMIN_PASSWORD="ChangeMe123"
